{
  "version": 1,
  "paths": [
    {
      "sync": "rclone://example-remote/example/path1",
      "cache": "/path/to/rclone/cache"
    },
    {
      "sync": "rclone://example-remote/example/path2",
      "cache": "/path/to/rclone/cache"
    }
  ],
  "walk": {
    "max_depth": null
  },
  "ignore": {
    "names": [".git", ".svn", "node_modules", ".cache", "target", "__pycache__"]
  },
  "mount_wait": {
    "initial_secs": 3,
    "retry_delays_secs": [3, 5, 8],
    "max_wait_secs": 30
  }
}
